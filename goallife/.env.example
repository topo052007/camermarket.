# Copier ce fichier en .env (jamais commité) puis remplir.
# Les variables EXPO_PUBLIC_ sont intégrées dans l'application : elles sont PUBLIQUES.
# N'y mettez JAMAIS la clé service role ni une clé d'IA.

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé publique (« anon » ou « publishable »). Protégée par la RLS côté serveur.
EXPO_PUBLIC_SUPABASE_KEY=

# Nom et identifiants de l'application (modifiables sans toucher au code)
APP_NAME=GoalLife
APP_SLUG=goallife
APP_SCHEME=goallife
APP_BUNDLE_ID=com.goallife.app
# Identifiant du projet EAS (après « npx eas-cli init ») : active les notifications push
EAS_PROJECT_ID=
