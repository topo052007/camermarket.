# Secrets des fonctions serveur. À définir avec :
#   npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournies automatiquement.)

# Coach IA. Laisser vide : l'application fonctionne, le coach indique qu'il n'est pas configuré.
IA_FOURNISSEUR=anthropic
ANTHROPIC_API_KEY=
# Modèle Claude (par défaut claude-opus-5-5). Choix du propriétaire selon son budget,
# par exemple claude-haiku-5-5 (beaucoup moins cher) ou claude-sonnet-5-5.
IA_MODELE=
# low (par défaut) | medium | high
IA_EFFORT=

# Webhook des abonnements (RevenueCat) : longue chaîne aléatoire, ex. « openssl rand -hex 32 »
WEBHOOK_ABONNEMENT_SECRET=

# Uniquement pour les tests automatisés : IA_FOURNISSEUR=simule et ENVIRONNEMENT=test
ENVIRONNEMENT=production
