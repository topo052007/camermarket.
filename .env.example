# Copiez ce fichier en .env.local et remplissez les valeurs. Ne publiez JAMAIS .env.local.

# Adresse PUBLIQUE du site. CinetPay refuse localhost pour la notification et le retour :
# en test, lancez un tunnel (par exemple ngrok http 3000) et mettez son adresse https ici.
NEXT_PUBLIC_SITE_URL=https://votre-tunnel.ngrok-free.app

# Pays ouverts à la vente (codes ISO séparés par des virgules). Sans réglage : CM seulement.
# N'ajoutez un pays qu'une fois que CinetPay a activé sa devise sur votre compte :
# un compte camerounais n'encaisse en général que le XAF (CM, GA, CG, TD, CF, GQ).
# Pays en XOF : CI, SN, BF, ML, TG, BJ, NE, GW.
PAYS_ACTIFS=CM

# Supabase : sur Vercel, l'intégration Supabase crée ces variables toute seule.
# Sinon : Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique : "publishable key" (sb_publishable_...) ou l'ancienne "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE : "secret key" (sb_secret_...) ou l'ancienne "service_role". Uniquement côté serveur.
SUPABASE_SECRET_KEY=

# E-mails de livraison : Resend (resend.com), Settings > API Keys
RESEND_API_KEY=
# Expéditeur. Il faut un domaine vérifié chez Resend ; pour un simple essai, Resend permet
# "onboarding@resend.dev" mais n'envoie alors qu'à l'adresse de votre propre compte Resend.
EMAIL_FROM=CamerMarket <commandes@votre-domaine.com>

# CinetPay : menu "Intégration" du compte marchand (app-new.cinetpay.com)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Clé secrète (facultative) : si elle est renseignée, les notifications sont vérifiées (x-token)
CINETPAY_SECRET_KEY=
# Moyens de paiement : MOBILE_MONEY (défaut), CREDIT_CARD, WALLET ou ALL.
# Les cartes demandent en plus l'adresse, la ville et le code postal du client (pas encore dans le formulaire).
CINETPAY_CHANNELS=MOBILE_MONEY
